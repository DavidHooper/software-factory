{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./.env.*.local)",
      "Read(./**/*.pem)",
      "Read(./.agent-run/gh-token.json)"
    ],
    "allow": [
      "Bash(node .harness/src/cli/github-write.ts PUT repos/{owner}/{repo}/pulls/* --input .agent-run/merge.json)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.harness/src/hooks/cloud-install.ts",
            "timeout": 600
          },
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.harness/src/hooks/session-start.ts",
            "timeout": 30
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR\"/.harness/src/hooks/user-prompt-submit.ts",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
